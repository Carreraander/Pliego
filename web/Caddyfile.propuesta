# pdfpliego.com · sitio estático (propuesta; NO desplegado: requiere aprobación de Ander).
# El VPS es compartido con otros sitios: este bloque NO va en el Caddyfile global. Se copia a
# /etc/caddy/sites.d/pdfpliego.caddy (el Caddyfile global ya hace `import sites.d/*.caddy`, como deja
# deploy/updates/setup-vps.sh) y se recarga con `systemctl reload caddy`.
# Requisito: registros DNS A/AAAA de pdfpliego.com y www.pdfpliego.com apuntando al VPS.
#
# HSTS con includeSubDomains obliga a HTTPS en TODOS los subdominios de pdfpliego.com durante un año.
# actualizaciones.pdfpliego.com ya va por HTTPS, así que no hay problema; cualquier subdominio nuevo
# tendrá que servirse también por HTTPS (Caddy lo hace solo).

www.pdfpliego.com {
	redir https://pdfpliego.com{uri} permanent
}

pdfpliego.com {
	root * /srv/pdfpliego.com
	encode zstd gzip
	file_server
	try_files {path} {path}/ {path}/index.html

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; style-src-attr 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
		-Server
	}
	# HTML siempre fresco; CSS e imágenes una semana (sin huella en el nombre todavía).
	@html path / *.html */
	header @html Cache-Control "no-cache"
	@static path /assets/* *.png *.svg *.ico *.webmanifest
	header @static Cache-Control "public, max-age=604800"

	log {
		output file /var/log/caddy/pdfpliego.log {
			roll_keep_for 168h
		}
	}
}

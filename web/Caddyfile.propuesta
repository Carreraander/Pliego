# pdfpliego.com · sitio estático (propuesta; NO desplegado: requiere aprobación de Ander).
# Se añade al Caddyfile del VPS junto al bloque de actualizaciones de deploy/updates/Caddyfile.
# Requisito: registros DNS A/AAAA de pdfpliego.com y www.pdfpliego.com apuntando al VPS.

www.pdfpliego.com {
	redir https://pdfpliego.com{uri} permanent
}

pdfpliego.com {
	root * /srv/pdfpliego.com
	encode zstd gzip
	file_server
	try_files {path} {path}/ {path}/index.html

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; style-src-attr 'unsafe-inline'; script-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
		-Server
	}
	# HTML siempre fresco; CSS e imágenes una semana (sin huella en el nombre todavía).
	@html path / *.html */
	header @html Cache-Control "no-cache"
	@static path /assets/* *.png *.svg *.ico *.webmanifest
	header @static Cache-Control "public, max-age=604800"

	log {
		output file /var/log/caddy/pdfpliego.log {
			roll_keep_for 168h
		}
	}
}
